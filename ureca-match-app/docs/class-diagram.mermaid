---
config:
  theme: base
  themeVariables:
    fontFamily: arial
---
classDiagram
    direction TB

    class User:::accountsAbstract {
        <<abstract>>
        -userId : String
        -email : String
        -name : String
        -role : Role
        -accountStatus : AccountStatus
        -createdAt : DateTime
        -lastLoginAt : DateTime
    }

    class Student:::accounts {
        -school : String
        -cgpa : Float
        -yearOfStudy : Integer
        -completedModules : List~String~
        -researchInterests : List~String~
        -isProfileComplete : Boolean
        -isEligibleForMatching : Boolean
    }

    class ProjectSupervisor:::accounts {
        -faculty : String
        -organisation : String
    }

    class Admin:::accounts {
    }

    class VerificationCode:::accounts {
        -code : String
        -expiresAt : DateTime
        -isUsed : Boolean
    }

    class ProjectListing:::projects {
        -listingId : String
        -title : String
        -description : String
        -prerequisites : List~String~
        -topicTags : List~String~
        -availableSlots : Integer
        -filledSlots : Integer
        -offeringFaculty : String
        -researchLocation : String
        -coverImageUrl : String
        -status : ListingStatus
        -createdAt : DateTime
    }

    class ApplicantRanking:::projects {
        -rankedApplicationIds : List~String~
        -submittedAt : DateTime
    }

    class Application:::applicationsAbstract {
        <<abstract>>
        -applicationId : String
        -statementOfInterest : String
        -submittedAt : DateTime
    }

    class ListingApplication:::applications {
        -preferenceRank : Integer
        -status : ApplicationStatus
    }

    class SelfProposedApplication:::applications {
        -title : String
        -description : String
        -researchInterests : List~String~
        -status : ProposalStatus
        -decidedAt : DateTime
    }

    class SupportingDocument:::applications {
        -documentId : String
        -fileName : String
        -fileFormat : String
        -fileSize : Integer
        -storagePath : String
        -uploadedAt : DateTime
    }

    class ApplicationCycle:::matching {
        -cycleId : String
        -academicYear : String
        -openingDate : DateTime
        -closingDate : DateTime
        -preApplicationDays : Integer
        -status : CycleStatus
    }

    class MatchingRound:::matching {
        -roundId : String
        -roundNumber : Integer
        -applicationWindowStart : DateTime
        -applicationWindowEnd : DateTime
        -reviewWindowStart : DateTime
        -reviewWindowEnd : DateTime
        -status : RoundStatus
        -executedAt : DateTime
        -publishedAt : DateTime
    }

    class MatchResult:::matching {
        -resultId : String
        -status : MatchStatus
        -preferenceRank : Integer
        -supervisorDecisionAt : DateTime
        -publishedAt : DateTime
        -offerExpiresAt : DateTime
        -studentResponseAt : DateTime
        -justification : String
    }

    class Notification:::crosscutting {
        -notificationId : String
        -event : NotificationEvent
        -title : String
        -message : String
        -createdAt : DateTime
        -isRead : Boolean
        -link : String
    }

    class AuditLogEntry:::crosscutting {
        -entryId : String
        -operation : AuditOperation
        -timestamp : DateTime
        -affectedRecords : List~String~
        -note : String
    }

    User <|-- Student
    User <|-- ProjectSupervisor
    User <|-- Admin
    Application <|-- ListingApplication
    Application <|-- SelfProposedApplication

    Student "1" --> "0..*" Application : submits
    Student "1" *-- "0..*" SupportingDocument : owns
    Application "0..*" --> "0..*" SupportingDocument : attaches

    ProjectSupervisor "1" --> "0..*" ProjectListing : creates
    ProjectSupervisor "1" --> "0..*" SelfProposedApplication : is directed
    ProjectListing "1" --> "0..*" ListingApplication : receives
    ProjectListing "1" --> "0..3" ApplicantRanking : is ranked in
    ApplicantRanking "0..*" --> "1..*" ListingApplication : orders

    ApplicationCycle "1" *-- "1..3" MatchingRound : comprises
    MatchingRound "1" --> "0..*" ListingApplication : accepts
    MatchingRound "1" --> "0..*" ApplicantRanking : collects
    MatchingRound "1" --> "0..*" MatchResult : produces
    MatchResult "0..*" --> "1" Student : allocates
    MatchResult "0..*" --> "1" ProjectListing : fills
    MatchResult "0..*" --> "0..1" ProjectListing : reassigned from

    Admin "1" --> "0..*" ApplicationCycle : creates
    User "1" --> "0..*" AuditLogEntry : initiates
    User "1" --> "0..*" Notification : receives
    User "1" --> "0..*" VerificationCode : is issued

    classDef accounts fill:#dbeafe,stroke:#1e40af,stroke-width:2px,color:#0f172a
    classDef accountsAbstract fill:#dbeafe,stroke:#1e40af,stroke-width:4px,color:#0f172a
    classDef projects fill:#dcfce7,stroke:#15803d,stroke-width:2px,color:#0f172a
    classDef applications fill:#fef3c7,stroke:#a16207,stroke-width:2px,color:#0f172a
    classDef applicationsAbstract fill:#fef3c7,stroke:#a16207,stroke-width:4px,color:#0f172a
    classDef matching fill:#ede9fe,stroke:#6d28d9,stroke-width:2px,color:#0f172a
    classDef crosscutting fill:#f1f5f9,stroke:#475569,stroke-width:2px,color:#0f172a
