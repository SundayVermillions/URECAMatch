# Copy to .env. Never commit .env.
API_MODE=mock                      # mock | supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=               # Settings > API > JWT Secret
APPROVED_EMAIL_DOMAINS=e.ntu.edu.sg,ntu.edu.sg
SESSION_MINUTES=30
CRON_SECRET=change-me              # shared with Vercel Cron
EMAIL_MODE=off                     # off | log | smtp | send. smtp is for your laptop (see docs/SETUP.md). Only production uses send
SMTP_HOST=localhost                # EMAIL_MODE=smtp only: where Mailpit listens. No login needed
SMTP_PORT=1025
RESEND_API_KEY=                    # resend.com > API Keys. Leave empty unless EMAIL_MODE=send
EMAIL_FROM=URECAMatch <onboarding@resend.dev>
APP_URL=http://localhost:3000      # base for links in e-mails
GEMINI_API_KEY=                    # aistudio.google.com > Get API key. Empty means AI match uses local scoring
GEMINI_MODEL=gemini-3.5-flash-lite
DEBUG_CLOCK=false                  # true on your laptop only: lets the top-right fake clock move "now". Never true in production.
# SCHEDULER_ON_REQUEST=false       # unset: on in mock mode, off in supabase mode (/internal/tick runs the schedule)
